10 REM SHAPES - triangles in MODE 1
20 MODE 1
30 VDU 23,1,0;0;0;0;
40 FOR I%=1 TO 300
50   X%=RND(1280):Y%=RND(1024)
60   GCOL 0,RND(3)
70   MOVE X%,Y%
80   MOVE X%+RND(200)-100,Y%+RND(200)-100
90   PLOT 85,X%+RND(200)-100,Y%+RND(200)-100
100 NEXT
110 PRINT TAB(0,31);"Press any key for menu";
120 A=GET
130 CHAIN "MENU"
