10 REM DRAW - pictures in SCREEN 2
20 SCREEN 2:COLOR 15,7,7:CLS
30 LINE(0,140)-(255,191),12,BF
40 CIRCLE(210,40),20,11:PAINT(210,40),11
50 LINE(40,90)-(120,140),9,BF
60 LINE(40,90)-(80,60),8:LINE-(120,90),8:LINE-(40,90),8
70 PAINT(80,80),8
80 LINE(70,110)-(90,140),1,BF
90 LINE(50,100)-(62,112),15,BF:LINE(98,100)-(110,112),15,BF
100 REM DRAW: a small language of moves
110 DRAW "BM150,140C2U30"
120 DRAW "BM150,110C3E8F8G8H8"
130 REM a square spiral: each side is longer
140 C=2:L=2
150 DRAW "BM190,100"
160 FOR I=1 TO 12
170 DRAW "C=C;R=L;":L=L+2:DRAW "D=L;":L=L+2
180 DRAW "L=L;":L=L+2:DRAW "U=L;":L=L+2
190 C=C+1:IF C>15 THEN C=2
200 IF L>40 THEN 220
210 NEXT I
220 OPEN "GRP:" AS #1
230 COLOR 1:PRESET(8,180):PRINT #1,"Press any key"
240 A$=INPUT$(1)
250 CLOSE #1:SCREEN 0:COLOR 15,4,4
