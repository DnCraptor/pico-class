10 REM REKORDY: TABLICA IZ PYATI REKORDOV (FAJL REKORDY.TXT)
20 DIM N$(6), S(6)
30 FOR I = 1 TO 5: N$(I) = "---": S(I) = 0: NEXT I
40 ON ERROR GOTO 300
50 OPEN "REKORDY.TXT" FOR INPUT AS #1
60 FOR I = 1 TO 5
70 LINE INPUT #1, N$(I)
80 INPUT #1, S(I)
90 NEXT I
100 CLOSE #1
110 ON ERROR GOTO 0
120 GOSUB 400
130 LINE INPUT "IMYA: "; N$(6)
140 INPUT "OCHKI"; S(6)
145 N$(6) = LEFT$(N$(6), 15)
150 REM SORTIROVKA OBMENOM: BOLSHIE OCHKI - NAVERH
160 FOR K = 1 TO 5
170 FOR I = 1 TO 6 - K
180 IF S(I) < S(I + 1) THEN SWAP S(I), S(I + 1): SWAP N$(I), N$(I + 1)
190 NEXT I
200 NEXT K
210 OPEN "REKORDY.TXT" FOR OUTPUT AS #1
220 FOR I = 1 TO 5
230 PRINT #1, N$(I)
240 PRINT #1, MID$(STR$(S(I)), 2)
250 NEXT I
260 CLOSE #1
270 GOSUB 400
280 END
300 REM FAJLA NET - NACHINAEM S PUSTOJ TABLICY
310 RESUME 110
400 PRINT : PRINT "   IMYA"; TAB(20); "OCHKI"
410 FOR I = 1 TO 5: PRINT I; N$(I); TAB(20); S(I): NEXT I
420 PRINT : RETURN
