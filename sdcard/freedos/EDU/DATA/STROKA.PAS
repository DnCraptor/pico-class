{ Строка в Паскале: длина хранится в нулевом байте }
program Stroka;
var
  a: string[10];       { не больше 10 букв }
  b: string;           { не больше 255 букв }
begin
  a := 'Привет';
  WriteLn(a, ' - длина ', Length(a), ', в байте a[0]: ', Ord(a[0]));
  b := a + ', мир!';
  WriteLn(b, ' - длина ', Length(b));
  a := 'Очень длинная строка';  { лишнее молча отрезается }
  WriteLn('в string[10] влезло: ', a);
  WriteLn('первые 3 буквы: ', Copy(b, 1, 3));
end.
