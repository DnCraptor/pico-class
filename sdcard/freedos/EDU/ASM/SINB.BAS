10 REM SINB: SINUSOIDA CHEREZ DMA. BEJSIK + 4 ZAPLATKI NA ASSEMBLERE
20 SG = 0: OF = 0: PG = 0: LO = 0: HI = 0: SCHET = 0: OB = 0
