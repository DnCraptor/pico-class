10 REM SINUS: SINUSOIDA CHEREZ DMA, BEZ PRERYVANIJ
20 REM VSE PEREMENNYE - ZARANEE: NOVAYA PEREMENNAYA SDVIGAET MASSIVY V PAMYATI!
30 I = 0: K = 0: S = 0: X = 0: O = 0: PA = 0: A0 = 0: F = 0: P = 0: ST = 0
40 B = 0: Q = 0: D = 0: M = 0: L = 0: H = 0: R = 0: V = 0: PG = 0: C = 0: LL = 0: N = 0: Z = 0
50 DIM BUF%(7999), T%(255)
60 REM PORT, IRQ I DMA - KAK V STROKE SET BLASTER=A220 I5 D1 V FDAUTO.BAT
70 REM (ENVIRON$ V NASHEJ SBORKE GW-BASIC NE RABOTAET)
80 B = &H220: Q = 5: D = 1
120 PRINT "SOUND BLASTER: PORT "; HEX$(B); "h, IRQ"; Q; ", DMA"; D
130 INPUT "CHASTOTA, Hz (NAPRIMER, 440)"; F
200 REM GDE LEZHIT MASSIV? ISCHEM SEGMENT DANNYH BEJSIKA
210 BUF%(0) = &H1234: BUF%(1) = &H5678: X = VARPTR(BUF%(0))
220 FOR S = 96 TO 40959!
230 DEF SEG = S: IF PEEK(X) <> &H34 THEN 270
240 IF PEEK(X + 1) <> &H12 OR PEEK(X + 2) <> &H78 OR PEEK(X + 3) <> &H56 THEN 270
250 POKE X, 0: IF BUF%(0) = &H1200 THEN 300
260 POKE X, &H34
270 NEXT S
280 DEF SEG: PRINT "MASSIV NE NAJDEN": END
300 PA = S * 16 + X: PRINT "SEGMENT"; HEX$(S); "  ADRES MASSIVA"; PA
310 REM OKNO, KOTOROE NE PERESEKAET GRANICU 64 KB
320 R = PA - INT(PA / 65536!) * 65536!
330 IF R + 8000 > 65536! THEN O = 65536! - R ELSE O = 0
340 PA = PA + O
400 REM SINUSOIDA: TABLICA NA 256 TOCHEK, POTOM 8000 OTSCHETOV
410 FOR I = 0 TO 255: T%(I) = 128 + INT(120 * SIN(I * 6.283185 / 256)): NEXT I
420 PRINT "ZAPOLNYAEM BLOK..."
430 P = 0: ST = F * 256 / 8000: DEF SEG = S
440 FOR K = 0 TO 7999: POKE X + O + K, T%(INT(P)): P = P + ST: IF P >= 256 THEN P = P - 256
450 NEXT K
460 DEF SEG
500 REM PRERYVANIE OT KARTY ZAKRYVAEM: OBRABOTCHIK NA BEJSIKE NE NAPISAT
510 M = INP(&H21): OUT &H21, M OR 2 ^ Q
520 OUT B + 6, 1: FOR I = 1 TO 10: NEXT I: OUT B + 6, 0
530 FOR I = 1 TO 1000: IF INP(B + &HE) AND 128 THEN 550
540 NEXT I
550 IF INP(B + &HA) <> &HAA THEN PRINT "SOUND BLASTER NE OTVECHAET": OUT &H21, M: END
600 REM KONTROLLER DMA: IZ PAMYATI V USTROJSTVO, S AVTOPOVTOROM
610 IF D = 0 THEN PG = &H87 ELSE IF D = 1 THEN PG = &H83 ELSE IF D = 2 THEN PG = &H81 ELSE PG = &H82
620 A0 = PA - INT(PA / 65536!) * 65536!
630 OUT &HA, 4 + D: OUT &HC, 0: OUT &HB, &H58 + D
640 OUT D * 2, A0 - INT(A0 / 256) * 256: OUT D * 2, INT(A0 / 256)
650 OUT PG, INT(PA / 65536!)
660 OUT D * 2 + 1, &H3F: OUT D * 2 + 1, &H1F
670 OUT &HA, D
700 REM SOUND BLASTER: 8000 Hz, BLOK 8000 BAJT, PUSK S AVTOPOVTOROM
710 V = &HD1: GOSUB 900
720 V = &H40: GOSUB 900: V = 131: GOSUB 900
730 V = &H48: GOSUB 900: V = &H3F: GOSUB 900: V = &H1F: GOSUB 900
740 V = &H1C: GOSUB 900
750 PRINT "IGRAET. LYUBAYA KLAVISHA - STOP.": R = CSRLIN: LL = 8000
755 REM OBRABOTCHIKA PRERYVANIYA NET - SAMI OPRASHIVAEM KARTU I DMA
760 OUT &HC, 0: L = INP(D * 2 + 1): H = INP(D * 2 + 1): C = L + 256 * H
765 IF C - LL > 4000 THEN N = N + 1: REM SCHETCHIK PRYGNUL VVERH - NACHALSYA NOVYJ BLOK
770 LL = C: Z = INP(B + &HE)
775 LOCATE R, 1: PRINT "BLOKOV:"; N; "  DMA: OSTALOS"; C; "BAJT   ";
780 IF INKEY$ = "" THEN 760
790 PRINT
800 V = &HD0: GOSUB 900: V = &HD3: GOSUB 900
810 OUT &HA, 4 + D: OUT &H21, M
820 OUT B + 6, 1: FOR I = 1 TO 10: NEXT I: OUT B + 6, 0
830 END
900 REM ZAPISAT V DSP: ZHDEM GOTOVNOSTI
910 IF INP(B + &HC) AND 128 THEN 910
920 OUT B + &HC, V: RETURN
