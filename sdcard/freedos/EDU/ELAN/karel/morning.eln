
program:
  start karel;
  make house;
  go to garden;
  take newspaper;
  go back to bed;
  stop.

  go to garden:
    walk along wall;
    walk through entrance;
    walk to newspaper.
  
    walk along wall:
      turn right;
      move;
      move;
      move;
      move;
      move.
    
    walk through entrance:
      turn left;
      move;
      move;
      move;
      move.
    
    walk to newspaper:
      turn left;
      move;
      move;
      turn left;
      move;
      move;
      turn right;
      move.
    
  take newspaper:
    take beeper.
  
  go back to bed:
    go back to entrance;
    walk back through entrance;
    walk back along wall.
  
    go back to entrance:
      turn about;
      move;
      turn left;
      move;
      move;
      turn right;
      move;
      move.
    
      turn about:
        turn right;
        turn right.
      
    walk back through entrance:
      turn right;
      move;
      move;
      move;
      move.
    
    walk back along wall:
      turn right;
      move;
      move;
      move;
      move;
      move.
    
