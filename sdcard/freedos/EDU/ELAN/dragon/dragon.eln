
program:
  setup dragon;
  start drawing;
  draw dragon (days, start cell);
  finish drawing.

  setup dragon:
    LET dragon name = "Heigway's Dragon";
    LET directions = 4;
    LET variants = 4;
    LET children = 2;
    ROW variants ROW children INT CONST offsprings :: [[0, 1], [2, 1], [2, 3], [0, 3]];
    ROW variants INT CONST behavior :: [0, 1, 2, 3];
    INT CONST days :: 12;
    INT CONST start cell :: 0;
    INT CONST size of cell :: 3;
    INT CONST start x :: 2 * graphics x limit DIV 3;
    INT CONST start y :: graphics y limit DIV 2.
  
