
program:
  setup dragon;
  start drawing;
  draw dragon (days, start cell);
  finish drawing.

  setup dragon:
    LET dragon name = "Pentigree Curve";
    LET directions = 5;
    LET variants = 5;
    LET children = 6;
    ROW variants ROW children INT CONST offsprings :: [[0, 4, 1, 2, 1, 0], [1, 0, 2, 3, 2, 1], [2, 1, 3, 4, 3, 2], [3, 2, 4, 0, 4, 3], [4, 3, 0, 1, 0, 4]];
    ROW variants INT CONST behavior :: [0, 1, 2, 3, 4];
    INT CONST days :: 4;
    INT CONST start cell :: 0;
    INT CONST size of cell :: 6;
    INT CONST start x :: graphics x limit DIV 2;
    INT CONST start y :: graphics y limit DIV 5.
  
