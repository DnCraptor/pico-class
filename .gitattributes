# Бинарники прошивок и содержимое эталонной SD-карты: никаких преобразований EOL
*.uf2 binary
sdcard/** -text
hardware/*/sdcard/** -text
# Текстовые файлы на SD-карте, которые читает прошивка, храним байт-в-байт
sdcard/**/config.sys -text
hardware/*/sdcard/**/config.sys -text

*.md text
# Памятки на SD-карте (CP866) читает MOS2: всегда LF, в том числе в Windows
sdcard/**/*.md text eol=lf
hardware/*/sdcard/**/*.md text eol=lf
SHA256SUMS text eol=lf
hardware/*/SHA256SUMS text eol=lf
